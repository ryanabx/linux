// SPDX-License-Identifier: (GPL-2.0 OR MIT)
/*
 * Amazon Fire TV Stick 3rd Gen (sheldonp)
 *
 * The Fire TV Stick Lite (sheldon) has the same board as far as the vendor
 * DT is concerned.
 */

/dts-v1/;
#include "mt8695.dtsi"
#include <dt-bindings/gpio/gpio.h>

/ {
	model = "Amazon Fire TV Stick 3rd Gen (sheldonp)";
	chassis-type = "embedded";
	compatible = "amazon,sheldonp", "mediatek,mt8695";

	aliases {
		mmc0 = &mmc0;
		mmc2 = &mmc2;
		serial0 = &uart1;
	};

	chosen {
		stdout-path = "serial0:921600n8";
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0 0x40000000 0 0x40000000>;
	};

	/* Both rails are fixed on the board; nothing in software switches them. */
	mmc_power: regulator-mmc-power {
		compatible = "regulator-fixed";
		regulator-name = "mmc_power";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	mmc_io: regulator-mmc-io {
		compatible = "regulator-fixed";
		regulator-name = "mmc_io";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};

	/*
	 * The MT7663 Wi-Fi/BT module on MSDC2: a fixed 3.3 V supply, and a
	 * 1.8 V I/O rail switched by GPIO126, which also powers the module up
	 * and down with the SDIO host.
	 */
	sdio_power: regulator-sdio-power {
		compatible = "regulator-fixed";
		regulator-name = "sdio_power";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	hdmi-connector {
		compatible = "hdmi-connector";
		label = "hdmi";
		type = "a";
		ddc-i2c-bus = <&hdmi_ddc>;
		hdmi-pwr-supply = <&hdmi_5v>;

		port {
			hdmi_connector_in: endpoint {
				remote-endpoint = <&hdmi_out>;
			};
		};
	};

	/* The TX's own DDC master is secure-only */
	hdmi_ddc: i2c-hdmi {
		compatible = "i2c-gpio";
		sda-gpios = <&pio 75 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&pio 74 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <5>;
		pinctrl-names = "default";
		pinctrl-0 = <&hdmi_ddc_pins>;
	};

	hdmi_5v: regulator-hdmi-5v {
		compatible = "regulator-fixed";
		regulator-name = "hdmi_5v";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&pio 60 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		/*
		 * On from the bootloader, and must stay on: driving GPIO60 low
		 * wedged the running board (2026-10-22).
		 */
		regulator-always-on;
		regulator-boot-on;
	};

	sound-hdmi {
		compatible = "mediatek,mt8695-hdmi-audio";
		mediatek,platform = <&afe>;
		mediatek,audio-codec = <&hdmi>;
	};

	sdio_io: regulator-sdio-io {
		compatible = "regulator-fixed";
		regulator-name = "sdio_io";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		gpio = <&pio 126 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	reserved-memory {
		/* Preloader/LK debug buffers, kept intact across warm resets */
		ram-console@44400000 {
			reg = <0 0x44400000 0 0x10000>;
			no-map;
		};

		/*
		 * Same region and layout as the bring-up ramoops in the vendor
		 * 4.4 kernel, so either kernel can read what the other logged
		 * before a warm reset.
		 */
		ramoops@44440000 {
			compatible = "ramoops";
			reg = <0 0x44440000 0 0x80000>;
			record-size = <0x10000>;
			console-size = <0x40000>;
			no-map;
		};

		minirdump@444f0000 {
			reg = <0 0x444f0000 0 0x10000>;
			no-map;
		};

		/* Secure world and bootloader carveouts above System RAM */
		/*
		 * LK's splash, still scanning out when larb4 switches to
		 * translation: mapped 1:1 through the M4U until the display
		 * driver replaces it.
		 */
		splash_mem: framebuffer@783c0000 {
			reg = <0 0x783c0000 0 0x1800000>;
			iommu-addresses = <&osd_fhd 0x0 0x783c0000 0x0 0x1800000>;
			no-map;
		};

		tee-reserved-memory@79bc0000 {
			reg = <0 0x79bc0000 0 0x6440000>;
			no-map;
		};
	};
};

&afe {
	status = "okay";
};

&cpu0 {
	proc-supply = <&mt6393_vproc>;
};

&cpu1 {
	proc-supply = <&mt6393_vproc>;
};

&cpu2 {
	proc-supply = <&mt6393_vproc>;
};

&cpu3 {
	proc-supply = <&mt6393_vproc>;
};

&hdmi {
	status = "okay";
};

&hdmi_phy {
	status = "okay";
};

&hdmi_port_out {
	hdmi_out: endpoint {
		remote-endpoint = <&hdmi_connector_in>;
	};
};

&i2c1 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1_pins>;
	status = "okay";

	pmic@60 {
		compatible = "mediatek,mt6393-regulator";
		reg = <0x60>;

		regulators {
			mt6393_vproc: buck-vproc {
				regulator-name = "vproc";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <1100000>;
				/*
				 * Not documented; a conservative slew, so the
				 * voltage has settled before the CPU clock rises.
				 */
				regulator-ramp-delay = <5000>;
				regulator-always-on;
				regulator-boot-on;
			};

			buck-vddr {
				regulator-name = "vddr";
				regulator-always-on;
				regulator-boot-on;
			};

			buck-vio18 {
				regulator-name = "vio18";
				regulator-always-on;
				regulator-boot-on;
			};

			buck-vio33 {
				regulator-name = "vio33";
				regulator-always-on;
				regulator-boot-on;
			};
		};
	};
};

&mmc0 {
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc0_pins_default>;
	pinctrl-1 = <&mmc0_pins_uhs>;
	bus-width = <8>;
	max-frequency = <200000000>;
	cap-mmc-highspeed;
	mmc-hs200-1_8v;
	mmc-hs400-1_8v;
	hs400-ds-delay = <0x14019>;
	cap-mmc-hw-reset;
	no-sd;
	no-sdio;
	vmmc-supply = <&mmc_power>;
	vqmmc-supply = <&mmc_io>;
	non-removable;
	status = "okay";
};

&mmc2 {
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc2_pins_default>;
	pinctrl-1 = <&mmc2_pins_uhs>;
	bus-width = <4>;
	max-frequency = <100000000>;
	cap-sd-highspeed;
	/*
	 * The vendor DT also allows SDR104, but without the vendor driver's
	 * tuning it gets data CRC errors on writes, and then the module stops
	 * answering. SDR50 is still far faster than the Wi-Fi link.
	 */
	sd-uhs-sdr50;
	keep-power-in-suspend;
	cap-sdio-irq;
	non-removable;
	no-mmc;
	no-sd;
	vmmc-supply = <&sdio_power>;
	vqmmc-supply = <&sdio_io>;
	status = "okay";
};

&osd_fhd {
	/* For its 1:1 mapping through the M4U, not as a buffer pool */
	memory-region = <&splash_mem>;
	status = "okay";
};

&osd_uhd {
	status = "okay";
};

&pio {
	/*
	 * A filter on the HDMI lines, switched in only for TMDS rates above
	 * 3.4 Gbps (the 4K modes, which this board doesn't run yet)
	 */
	hdmi-filter-hog {
		gpio-hog;
		gpios = <81 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "hdmi-filter";
	};

	mmc0_pins_default: mmc0-default-pins {
		pins-cmd-dat {
			pinmux = <MT8695_PIN_44_EMMC_DAT0__FUNC_MSDC0_DAT0>,
				 <MT8695_PIN_43_EMMC_DAT1__FUNC_MSDC0_DAT1>,
				 <MT8695_PIN_42_EMMC_DAT2__FUNC_MSDC0_DAT2>,
				 <MT8695_PIN_41_EMMC_DAT3__FUNC_MSDC0_DAT3>,
				 <MT8695_PIN_40_EMMC_DAT4__FUNC_MSDC0_DAT4>,
				 <MT8695_PIN_39_EMMC_DAT5__FUNC_MSDC0_DAT5>,
				 <MT8695_PIN_38_EMMC_DAT6__FUNC_MSDC0_DAT6>,
				 <MT8695_PIN_37_EMMC_DAT7__FUNC_MSDC0_DAT7>,
				 <MT8695_PIN_45_EMMC_CMD__FUNC_MSDC0_CMD>;
			input-enable;
			drive-strength = <MTK_DRIVE_6mA>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};

		pins-clk {
			pinmux = <MT8695_PIN_36_EMMC_CLK__FUNC_MSDC0_CLK>;
			drive-strength = <MTK_DRIVE_6mA>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
		};

		pins-rst {
			pinmux = <MT8695_PIN_46_EMMC_RSTB__FUNC_MSDC0_RSTB>;
			bias-pull-up;
		};
	};

	mmc0_pins_uhs: mmc0-uhs-pins {
		pins-cmd-dat {
			pinmux = <MT8695_PIN_44_EMMC_DAT0__FUNC_MSDC0_DAT0>,
				 <MT8695_PIN_43_EMMC_DAT1__FUNC_MSDC0_DAT1>,
				 <MT8695_PIN_42_EMMC_DAT2__FUNC_MSDC0_DAT2>,
				 <MT8695_PIN_41_EMMC_DAT3__FUNC_MSDC0_DAT3>,
				 <MT8695_PIN_40_EMMC_DAT4__FUNC_MSDC0_DAT4>,
				 <MT8695_PIN_39_EMMC_DAT5__FUNC_MSDC0_DAT5>,
				 <MT8695_PIN_38_EMMC_DAT6__FUNC_MSDC0_DAT6>,
				 <MT8695_PIN_37_EMMC_DAT7__FUNC_MSDC0_DAT7>,
				 <MT8695_PIN_45_EMMC_CMD__FUNC_MSDC0_CMD>;
			input-enable;
			drive-strength = <MTK_DRIVE_6mA>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};

		pins-clk {
			pinmux = <MT8695_PIN_36_EMMC_CLK__FUNC_MSDC0_CLK>;
			drive-strength = <MTK_DRIVE_6mA>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
		};

		pins-ds {
			pinmux = <MT8695_PIN_35_EMMC_DSL__FUNC_MSDC0_DSL>;
			drive-strength = <MTK_DRIVE_6mA>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
		};

		pins-rst {
			pinmux = <MT8695_PIN_46_EMMC_RSTB__FUNC_MSDC0_RSTB>;
			bias-pull-up;
		};
	};

	/* Pulled up on the board (and by the sink) */
	hdmi_ddc_pins: hdmi-ddc-pins {
		pins-ddc {
			pinmux = <MT8695_PIN_74_HDMITX20_HDMISCK__FUNC_GPIO74>,
				 <MT8695_PIN_75_HDMITX20_HDMISD__FUNC_GPIO75>;
			bias-disable;
		};
	};

	i2c1_pins: i2c1-pins {
		pins-bus {
			pinmux = <MT8695_PIN_56_SDA1__FUNC_SDA1>,
				 <MT8695_PIN_57_SCL1__FUNC_SCL1>;
			bias-pull-up;
		};
	};

	mmc2_pins_default: mmc2-default-pins {
		pins-cmd-dat {
			pinmux = <MT8695_PIN_33_MSDC2_DATA0__FUNC_MSDC2_DAT0>,
				 <MT8695_PIN_32_MSDC2_DATA1__FUNC_MSDC2_DAT1>,
				 <MT8695_PIN_31_MSDC2_DATA2__FUNC_MSDC2_DAT2>,
				 <MT8695_PIN_30_MSDC2_DATA3__FUNC_MSDC2_DAT3>,
				 <MT8695_PIN_34_MSDC2_CMD__FUNC_MSDC2_CMD>;
			input-enable;
			drive-strength = <MTK_DRIVE_6mA>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_10>;
		};

		pins-clk {
			pinmux = <MT8695_PIN_28_MSDC2_CLK__FUNC_MSDC2_CLK>;
			drive-strength = <MTK_DRIVE_6mA>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
		};
	};

	/* Same as the default state, as in the vendor DT */
	mmc2_pins_uhs: mmc2-uhs-pins {
		pins-cmd-dat {
			pinmux = <MT8695_PIN_33_MSDC2_DATA0__FUNC_MSDC2_DAT0>,
				 <MT8695_PIN_32_MSDC2_DATA1__FUNC_MSDC2_DAT1>,
				 <MT8695_PIN_31_MSDC2_DATA2__FUNC_MSDC2_DAT2>,
				 <MT8695_PIN_30_MSDC2_DATA3__FUNC_MSDC2_DAT3>,
				 <MT8695_PIN_34_MSDC2_CMD__FUNC_MSDC2_CMD>;
			input-enable;
			drive-strength = <MTK_DRIVE_6mA>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_10>;
		};

		pins-clk {
			pinmux = <MT8695_PIN_28_MSDC2_CLK__FUNC_MSDC2_CLK>;
			drive-strength = <MTK_DRIVE_6mA>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
		};
	};
};

&ssusb {
	dr_mode = "otg";
	usb-role-switch;
	status = "okay";

	connector {
		compatible = "gpio-usb-b-connector", "usb-b-connector";
		type = "micro";
		id-gpios = <&pio 55 GPIO_ACTIVE_HIGH>;
	};
};

&tphy {
	status = "okay";
};

/* The micro-USB port; eye-pattern tuning from the vendor DT */
&u2port0 {
	mediatek,eye-src = <3>;
	mediatek,eye-vrt = <4>;
	mediatek,eye-term = <4>;
};

&usb_host {
	status = "okay";
};

&uart1 {
	status = "okay";
};

&vdout {
	status = "okay";
};
