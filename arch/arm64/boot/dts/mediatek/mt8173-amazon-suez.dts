		mt6397pin: pinctrl {
			compatible = "mediatek,mt6397-pinctrl";
			gpio-controller;
			#gpio-cells = <2>;
		};

		mt6397keys: keys {
			compatible = "mediatek,mt6397-keys";
			mediatek,long-press-mode = <1>;
			power-off-time-sec = <0>;

			power {
				linux,keycodes = <KEY_POWER>;
				wakeup-source;
			};
		};

		regulators {
			compatible = "mediatek,mt6397-regulator";

			mt6397_vpca15_reg: buck_vpca15 {
				regulator-name = "vpca15";
				regulator-min-microvolt = < 700000>;
				regulator-max-microvolt = <1350000>;
				regulator-ramp-delay = <12500>;
				regulator-always-on;
			};

			mt6397_vpca7_reg: buck_vpca7 {
				regulator-name = "vpca7";
				regulator-min-microvolt = < 700000>;
				regulator-max-microvolt = <1350000>;
				regulator-ramp-delay = <12500>;
				regulator-enable-ramp-delay = <115>;
			};

			mt6397_vsramca15_reg: buck_vsramca15 {
				regulator-name = "vsramca15";
				regulator-min-microvolt = < 700000>;
				regulator-max-microvolt = <1350000>;
				regulator-ramp-delay = <12500>;
				regulator-always-on;
			};

			/* The A72 cluster's Vsram despite the name; cpufreq couples the pair. */
			mt6397_vsramca7_reg: buck_vsramca7 {
				regulator-name = "vsramca7";
				regulator-min-microvolt = < 700000>;
				regulator-max-microvolt = <1350000>;
				regulator-ramp-delay = <12500>;
				regulator-always-on;
			};

			mt6397_vcore_reg: buck_vcore {
				regulator-name = "vcore";
				regulator-min-microvolt = < 700000>;
				regulator-max-microvolt = <1350000>;
				regulator-ramp-delay = <12500>;
				regulator-always-on;
			};

			/* 150 us per suez_evt/dvt, not the 115 us of evb and elm. */
			mt6397_vgpu_reg: buck_vgpu {
				regulator-name = "vgpu";
				regulator-min-microvolt = < 700000>;
				regulator-max-microvolt = <1350000>;
				regulator-ramp-delay = <12500>;
				regulator-enable-ramp-delay = <150>;
			};

			mt6397_vdrm_reg: buck_vdrm {
				regulator-name = "vdrm";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <1400000>;
				regulator-ramp-delay = <12500>;
				regulator-always-on;
			};

			mt6397_vio18_reg: buck_vio18 {
				regulator-name = "vio18";
				regulator-min-microvolt = <1620000>;
				regulator-max-microvolt = <1980000>;
				regulator-ramp-delay = <12500>;
				regulator-always-on;
			};

			mt6397_vtcxo_reg: ldo_vtcxo {
				regulator-name = "vtcxo";
				regulator-always-on;
			};

			mt6397_va28_reg: ldo_va28 {
				regulator-name = "va28";
				regulator-always-on;
			};

			mt6397_vcama_reg: ldo_vcama {
				regulator-name = "vcama";
				regulator-min-microvolt = <1500000>;
				regulator-max-microvolt = <2800000>;
				regulator-enable-ramp-delay = <218>;
			};

			mt6397_vio28_reg: ldo_vio28 {
				regulator-name = "vio28";
				regulator-always-on;
			};

			mt6397_vusb_reg: ldo_vusb {
				regulator-name = "vusb";
			};

			mt6397_vmc_reg: ldo_vmc {
				regulator-name = "vmc";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
				regulator-enable-ramp-delay = <218>;
			};

			mt6397_vmch_reg: ldo_vmch {
				regulator-name = "vmch";
				regulator-min-microvolt = <3000000>;
				regulator-max-microvolt = <3300000>;
				regulator-enable-ramp-delay = <218>;
			};

			mt6397_vemc_3v3_reg: ldo_vemc3v3 {
				regulator-name = "vemc_3v3";
				regulator-min-microvolt = <3000000>;
				regulator-max-microvolt = <3300000>;
				regulator-enable-ramp-delay = <218>;
			};

			mt6397_vgp1_reg: ldo_vgp1 {
				regulator-name = "vcamd";
				regulator-min-microvolt = <1220000>;
				regulator-max-microvolt = <3300000>;
				regulator-enable-ramp-delay = <240>;
			};

			mt6397_vgp2_reg: ldo_vgp2 {
				regulator-name = "vcamio";
				regulator-min-microvolt = <1000000>;
				regulator-max-microvolt = <3300000>;
				regulator-enable-ramp-delay = <218>;
			};

			mt6397_vgp3_reg: ldo_vgp3 {
				regulator-name = "vcamaf";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <3300000>;
				regulator-enable-ramp-delay = <218>;
			};

			mt6397_vgp4_reg: ldo_vgp4 {
				regulator-name = "vgp4";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <3300000>;
				regulator-enable-ramp-delay = <218>;
			};

			mt6397_vgp5_reg: ldo_vgp5 {
				regulator-name = "vgp5";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <3000000>;
				regulator-enable-ramp-delay = <218>;
			};

			mt6397_vgp6_reg: ldo_vgp6 {
				regulator-name = "vgp6";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <3300000>;
				regulator-enable-ramp-delay = <218>;
			};

			mt6397_vibr_reg: ldo_vibr {
				regulator-name = "vibr";
				regulator-min-microvolt = <1300000>;
				regulator-max-microvolt = <3300000>;
				regulator-enable-ramp-delay = <218>;
			};
		};
	};
};

&scpsys {
	/*
	 * Suspend-to-RAM. This board's firmware is PSCI 0.2, which predates
	 * SYSTEM_SUSPEND, so the kernel is never given platform_suspend_ops
	 * and /sys/power/mem_sleep offers only s2idle. mtk-spm-suspend drives
	 * the SPM from the kernel instead, the way the vendor kernel does.
	 *
	 * This is deliberately a board property rather than something in
	 * mt8173.dtsi: mt8173-elm and mt8173-oak ship ARM Trusted Firmware,
	 * where BL31 does this same work at EL3, and adding the node there
	 * would put two suspend implementations on the same hardware.
	 */
	spm_suspend: spm-suspend {
		compatible = "mediatek,mt8173-spm-suspend";

		/* SPM IRQ0, as the vendor's scpsys node has it (155..160). */
		interrupts = <GIC_SPI 155 IRQ_TYPE_LEVEL_LOW>;

		/* MP0_AXI_CONFIG, for ACINACTM around the WFI */
		mediatek,mcucfg = <&mcucfg>;

		/*
		 * The rails feeding the still-powered CPU must not follow
		 * SRCLKEN down while the SoC is asleep.
		 */
		mediatek,pmic = <&pmic>;

		/*
		 * fscp_ck is parked on the crystal for the duration, because
		 * the SPM stops the PLL it normally runs from.
		 */
		clocks = <&topckgen CLK_TOP_SCP_SEL>,
			 <&topckgen CLK_TOP_SYSPLL1_D2>,
			 <&clk26m>;
		clock-names = "scp_sel", "syspll1_d2", "clk26m";
	};
};

/* Peripheral only: the single micro-B port is also the charger input. */
&ssusb {
	vusb33-supply = <&mt6397_vusb_reg>;
	dr_mode = "peripheral";
	maximum-speed = "high-speed";
	status = "okay";
};

&{/soc} {
	/*
	 * mt8173.dtsi has no MCUCFG node, but powering the A72 cluster needs
	 * CA15L_MISCDBG to deassert ACINACTM. Naming follows mt2712e.dtsi's
	 * "mediatek,mt2712-mcucfg", "syscon".
	 */
	mcucfg: syscon@10200000 {
		compatible = "mediatek,mt8173-mcucfg", "syscon";
		reg = <0 0x10200000 0 0x1000>;
	};
};

&uart0 {
	status = "okay";
};

/* Consumes the VPU, which does not run here. See &vpu below. */
&vcodec_dec {
	status = "disabled";
};

&vcodec_enc_avc {
	status = "disabled";
};

&vcodec_enc_vp8 {
	status = "disabled";
};

/*
 * Disabled: the firmware never starts here and mtk_vpu_suspend() then
 * returns -EIO, aborting every suspend. Its four consumers resolve the
 * mediatek,vpu phandle through vpu_get_plat_device() and WARN_ON() a
 * disabled node, so they are disabled too rather than left to backtrace.
 */
&vpu {
	status = "disabled";
};
