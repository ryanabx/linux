/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/iio/adc/mediatek,mt6397-auxadc.h>
#include <dt-bindings/input/input.h>
#include "mt8173.dtsi"

/ {
	model = "Amazon Fire HD 10 (2017)";
	compatible = "amazon,suez", "mediatek,mt8173";

	/*
	 * The vendor bootloader (LK) chooses which appended DTB to hand to the
	 * kernel by board revision: shipping only the vendor "hvt" DTB does not
	 * boot, shipping only the vendor "dvt" one does, and this unit reports
	 * version = "dvt". A DTB LK does not select is silently ignored and the
	 * kernel is never entered at all - which is why a mainline DTB carrying
	 * neither property never got control.
	 *
	 * Nothing in mainline binds to this property; it exists only so LK
	 * selects the DTB. It is kept here because the DTB is appended to the
	 * kernel image as-is; a packaging step that patched it in would be the
	 * alternative.
	 */
	version = "dvt";

	aliases {
		/* Pin the MMC indices; the SD slot otherwise renames the eMMC. */
		mmc0 = &mmc0;
		mmc1 = &mmc1;

		serial0 = &uart0;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		stdout-path = "serial0:921600n8";

		/*
		 * LK lights the panel to draw its logo and leaves it running,
		 * which is the only console this device has until the display
		 * driver binds: the UART is not brought out on a retail unit.
		 *
		 * This window is not reserved here on purpose. LK rewrites
		 * /memory and injects its own no-map carve-outs for the
		 * framebuffer, the secure OS and the VPU pool before entering
		 * the kernel, so a second reservation for the same range only
		 * earns an "OVERLAP DETECTED" from of_reserved_mem.
		 */
		framebuffer@b4bc0000 {
			compatible = "simple-framebuffer";
			reg = <0 0xb4bc0000 0 (1216 * 1920 * 4)>;
			width = <1200>;
			height = <1920>;
			/* Scanlines are padded to 1216 px; a wrong stride shears the image. */
			stride = <(1216 * 4)>;
			format = "a8r8g8b8";
		};
	};

	/*
	 * The pack. Everything the gauge needs is on the fuel-gauge node below;
	 * this node carries only what the power-supply core reads for the
	 * generic properties. The figures are the vendor's for the Desay cell
	 * this unit is fitted with (IDME productid2 0831 = BATTERY_ID_DSY;
	 * ATL units read 0841), from suez_bat_setting.dtsi battery_dsy_setting:
	 * q_max_pos_25 and the 25 C profile's end points. Nothing here is
	 * measured on this board.
	 */
	battery: battery {
		compatible = "simple-battery";
		device-chemistry = "lithium-ion";
		voltage-min-design-microvolt = <3352000>;
		voltage-max-design-microvolt = <4321000>;
		charge-full-design-microamp-hours = <6348000>;
		constant-charge-voltage-max-microvolt = <4352000>;

		/*
		 * The vendor's characterisation of the Desay cell, from
		 * suez_bat_setting.dtsi battery_dsy_setting: five open-circuit
		 * voltage curves of 120 points each, taken at -10, 0, 10, 25 and
		 * 50 C (its t0, t1, t1_5, t2 and t3). The vendor spells them as
		 * depth of discharge against millivolts and pads the tail of each
		 * with repeats of its last point, marked as 101 % discharged,
		 * which has no capacity to express it and reads 0 % here.
		 */
		ocv-capacity-celsius = <(-10) 0 10 25 50>;
		ocv-capacity-table-0 =
			<4275000 100>, <4252000 99>, <4237000 98>,
			<4226000 97>, <4215000 96>, <4205000 95>, <4196000 95>,
			<4186000 94>, <4177000 93>, <4167000 92>, <4158000 91>,
			<4149000 90>, <4139000 89>, <4130000 88>, <4121000 87>,
			<4113000 86>, <4104000 85>, <4098000 85>, <4092000 84>,
			<4088000 83>, <4083000 82>, <4076000 81>, <4065000 80>,
			<4049000 79>, <4030000 78>, <4012000 77>, <3998000 76>,
			<3987000 75>, <3978000 75>, <3971000 74>, <3965000 73>,
			<3959000 72>, <3955000 71>, <3950000 70>, <3945000 69>,
			<3941000 68>, <3936000 67>, <3929000 66>, <3923000 65>,
			<3916000 65>, <3909000 64>, <3901000 63>, <3894000 62>,
			<3886000 61>, <3879000 60>, <3872000 59>, <3866000 58>,
			<3860000 57>, <3854000 56>, <3850000 56>, <3847000 55>,
			<3843000 54>, <3840000 53>, <3836000 52>, <3833000 51>,
			<3829000 50>, <3826000 49>, <3823000 48>, <3820000 47>,
			<3817000 46>, <3813000 46>, <3811000 45>, <3808000 44>,
			<3805000 43>, <3803000 42>, <3800000 41>, <3798000 40>,
			<3796000 39>, <3794000 38>, <3791000 37>, <3790000 36>,
			<3788000 36>, <3786000 35>, <3784000 34>, <3782000 33>,
			<3780000 32>, <3778000 31>, <3776000 30>, <3774000 29>,
			<3772000 28>, <3769000 27>, <3766000 26>, <3763000 26>,
			<3759000 25>, <3756000 24>, <3752000 23>, <3749000 22>,
			<3746000 21>, <3743000 20>, <3740000 19>, <3736000 18>,
			<3731000 17>, <3725000 16>, <3720000 16>, <3716000 15>,
			<3711000 14>, <3704000 13>, <3697000 12>, <3694000 11>,
			<3693000 10>, <3692000 9>, <3691000 8>, <3689000 7>,
			<3687000 6>, <3684000 6>, <3676000 5>, <3651000 4>,
			<3613000 3>, <3565000 2>, <3504000 1>, <3419000 0>,
			<3277000 0>, <3277000 0>, <3277000 0>, <3277000 0>,
			<3277000 0>, <3277000 0>, <3277000 0>, <3277000 0>,
			<3277000 0>;
		ocv-capacity-table-1 =
			<4287000 100>, <4267000 99>, <4253000 98>,
			<4241000 97>, <4230000 96>, <4220000 96>, <4210000 95>,
			<4201000 94>, <4192000 93>, <4183000 92>, <4175000 91>,
			<4166000 90>, <4157000 89>, <4148000 89>, <4139000 88>,
			<4130000 87>, <4121000 86>, <4113000 85>, <4105000 84>,
			<4098000 83>, <4091000 82>, <4088000 82>, <4084000 81>,
			<4079000 80>, <4070000 79>, <4055000 78>, <4036000 77>,
			<4018000 76>, <4003000 75>, <3990000 74>, <3982000 74>,
			<3975000 73>, <3969000 72>, <3963000 71>, <3960000 70>,
			<3956000 69>, <3952000 68>, <3949000 67>, <3945000 67>,
			<3940000 66>, <3935000 65>, <3929000 64>, <3923000 63>,
			<3915000 62>, <3908000 61>, <3899000 60>, <3890000 60>,
			<3882000 59>, <3874000 58>, <3867000 57>, <3861000 56>,
			<3855000 55>, <3850000 54>, <3845000 53>, <3841000 53>,
			<3836000 52>, <3832000 51>, <3829000 50>, <3825000 49>,
			<3822000 48>, <3819000 47>, <3816000 46>, <3813000 45>,
			<3810000 45>, <3807000 44>, <3805000 43>, <3802000 42>,
			<3800000 41>, <3798000 40>, <3796000 39>, <3794000 38>,
			<3792000 38>, <3790000 37>, <3789000 36>, <3788000 35>,
			<3787000 34>, <3786000 33>, <3785000 32>, <3784000 31>,
			<3784000 31>, <3783000 30>, <3781000 29>, <3780000 28>,
			<3779000 27>, <3777000 26>, <3775000 25>, <3773000 24>,
			<3770000 23>, <3768000 23>, <3765000 22>, <3761000 21>,
			<3756000 20>, <3755000 19>, <3750000 18>, <3745000 17>,
			<3740000 16>, <3735000 16>, <3730000 15>, <3725000 14>,
			<3719000 13>, <3712000 12>, <3706000 11>, <3704000 10>,
			<3702000 9>, <3700000 9>, <3698000 8>, <3695000 7>,
			<3692000 6>, <3685000 5>, <3670000 4>, <3639000 3>,
			<3594000 2>, <3536000 2>, <3457000 1>, <3335000 0>,
			<3335000 0>, <3335000 0>, <3335000 0>, <3335000 0>,
			<3335000 0>;
		ocv-capacity-table-2 =
			<4309000 100>, <4292000 99>, <4279000 98>,
			<4268000 97>, <4258000 97>, <4248000 96>, <4238000 95>,
			<4229000 94>, <4219000 93>, <4210000 92>, <4201000 91>,
			<4192000 90>, <4183000 90>, <4174000 89>, <4165000 88>,
			<4156000 87>, <4147000 86>, <4138000 85>, <4129000 84>,
			<4120000 83>, <4112000 83>, <4103000 82>, <4095000 81>,
			<4088000 80>, <4084000 79>, <4080000 78>, <4076000 77>,
			<4069000 77>, <4056000 76>, <4037000 75>, <4019000 74>,
			<4005000 73>, <3994000 72>, <3985000 71>, <3978000 70>,
			<3972000 70>, <3967000 69>, <3964000 68>, <3961000 67>,
			<3958000 66>, <3955000 65>, <3951000 64>, <3945000 63>,
			<3939000 63>, <3933000 62>, <3925000 61>, <3917000 60>,
			<3907000 59>, <3897000 58>, <3888000 57>, <3879000 57>,
			<3872000 56>, <3865000 55>, <3860000 54>, <3855000 53>,
			<3850000 52>, <3846000 51>, <3841000 50>, <3837000 50>,
			<3834000 49>, <3830000 48>, <3826000 47>, <3823000 46>,
			<3820000 45>, <3817000 44>, <3814000 43>, <3811000 43>,
			<3808000 42>, <3806000 41>, <3803000 40>, <3801000 39>,
			<3798000 38>, <3796000 37>, <3794000 37>, <3791000 36>,
			<3790000 35>, <3788000 34>, <3786000 33>, <3784000 32>,
			<3783000 31>, <3781000 30>, <3780000 30>, <3779000 29>,
			<3778000 28>, <3776000 27>, <3774000 26>, <3772000 25>,
			<3770000 24>, <3767000 23>, <3764000 23>, <3761000 22>,
			<3758000 21>, <3755000 20>, <3752000 19>, <3749000 18>,
			<3744000 17>, <3739000 17>, <3734000 16>, <3729000 15>,
			<3725000 14>, <3719000 13>, <3711000 12>, <3705000 11>,
			<3702000 10>, <3701000 10>, <3699000 9>, <3698000 8>,
			<3697000 7>, <3694000 6>, <3686000 5>, <3681000 4>,
			<3653000 3>, <3612000 3>, <3561000 2>, <3495000 1>,
			<3400000 0>, <3225000 0>, <3225000 0>, <3225000 0>,
			<3225000 0>;
		ocv-capacity-table-3 =
			<4321000 100>, <4304000 99>, <4292000 98>,
			<4280000 97>, <4270000 97>, <4260000 96>, <4250000 95>,
			<4240000 94>, <4231000 93>, <4221000 92>, <4212000 91>,
			<4203000 91>, <4194000 90>, <4184000 89>, <4176000 88>,
			<4167000 87>, <4158000 86>, <4149000 86>, <4140000 85>,
			<4131000 84>, <4122000 83>, <4113000 82>, <4104000 81>,
			<4095000 80>, <4087000 80>, <4079000 79>, <4073000 78>,
			<4069000 77>, <4065000 76>, <4058000 75>, <4045000 74>,
			<4029000 74>, <4014000 73>, <4002000 72>, <3992000 71>,
			<3984000 70>, <3978000 69>, <3974000 69>, <3970000 68>,
			<3969000 67>, <3966000 66>, <3961000 65>, <3955000 64>,
			<3948000 63>, <3943000 63>, <3936000 62>, <3930000 61>,
			<3924000 60>, <3917000 59>, <3909000 58>, <3900000 57>,
			<3890000 57>, <3879000 56>, <3871000 55>, <3863000 54>,
			<3858000 53>, <3853000 52>, <3848000 52>, <3843000 51>,
			<3839000 50>, <3835000 49>, <3831000 48>, <3828000 47>,
			<3824000 46>, <3820000 46>, <3817000 45>, <3814000 44>,
			<3811000 43>, <3808000 42>, <3805000 41>, <3803000 40>,
			<3800000 40>, <3798000 39>, <3796000 38>, <3793000 37>,
			<3791000 36>, <3789000 35>, <3787000 34>, <3785000 34>,
			<3783000 33>, <3781000 32>, <3779000 31>, <3777000 30>,
			<3775000 29>, <3774000 29>, <3770000 28>, <3767000 27>,
			<3765000 26>, <3762000 25>, <3759000 24>, <3756000 23>,
			<3752000 23>, <3750000 22>, <3747000 21>, <3744000 20>,
			<3742000 19>, <3739000 18>, <3736000 17>, <3730000 17>,
			<3726000 16>, <3721000 15>, <3716000 14>, <3712000 13>,
			<3706000 12>, <3698000 12>, <3693000 11>, <3691000 10>,
			<3691000 9>, <3690000 8>, <3688000 7>, <3686000 6>,
			<3684000 6>, <3678000 5>, <3662000 4>, <3628000 3>,
			<3586000 2>, <3531000 1>, <3460000 0>, <3352000 0>,
			<3352000 0>;
		ocv-capacity-table-4 =
			<4337000 100>, <4321000 99>, <4307000 98>,
			<4294000 97>, <4282000 97>, <4270000 96>, <4259000 95>,
			<4249000 94>, <4238000 93>, <4228000 92>, <4219000 91>,
			<4209000 91>, <4199000 90>, <4190000 89>, <4181000 88>,
			<4171000 87>, <4162000 86>, <4153000 86>, <4144000 85>,
			<4135000 84>, <4126000 83>, <4118000 82>, <4109000 81>,
			<4100000 80>, <4092000 80>, <4084000 79>, <4075000 78>,
			<4067000 77>, <4059000 76>, <4051000 75>, <4043000 74>,
			<4036000 74>, <4028000 73>, <4020000 72>, <4013000 71>,
			<4006000 70>, <3999000 69>, <3992000 69>, <3985000 68>,
			<3978000 67>, <3972000 66>, <3965000 65>, <3959000 64>,
			<3953000 63>, <3946000 63>, <3940000 62>, <3934000 61>,
			<3927000 60>, <3921000 59>, <3914000 58>, <3907000 57>,
			<3898000 57>, <3888000 56>, <3878000 55>, <3870000 54>,
			<3863000 53>, <3857000 52>, <3852000 51>, <3847000 51>,
			<3843000 50>, <3839000 49>, <3834000 48>, <3831000 47>,
			<3827000 46>, <3823000 46>, <3820000 45>, <3817000 44>,
			<3813000 43>, <3810000 42>, <3807000 41>, <3804000 40>,
			<3802000 40>, <3799000 39>, <3796000 38>, <3794000 37>,
			<3792000 36>, <3789000 35>, <3787000 34>, <3785000 34>,
			<3783000 33>, <3781000 32>, <3779000 31>, <3777000 30>,
			<3774000 29>, <3770000 29>, <3764000 28>, <3758000 27>,
			<3753000 26>, <3749000 25>, <3746000 24>, <3743000 23>,
			<3739000 23>, <3736000 22>, <3733000 21>, <3730000 20>,
			<3727000 19>, <3724000 18>, <3721000 17>, <3717000 17>,
			<3712000 16>, <3707000 15>, <3702000 14>, <3698000 13>,
			<3692000 12>, <3685000 11>, <3680000 11>, <3679000 10>,
			<3678000 9>, <3678000 8>, <3676000 7>, <3675000 6>,
			<3672000 6>, <3666000 5>, <3647000 4>, <3614000 3>,
			<3572000 2>, <3519000 1>, <3450000 0>, <3350000 0>,
			<3171000 0>;
	};

	/*
	 * The pack thermistor, on the PMIC's AUXADC rather than the SoC's,
	 * under the pull-up the vendor calls rbat_pull_up_r and
	 * rbat_pull_up_volt. Its 19-point table in suez_bat_setting.dtsi is a
	 * 47 kOhm-at-25C NTC and agrees with mainline's ncp15wb473 curve to
	 * within 0.5 C over the -20 to 70 C it covers.
	 */
	batt_therm: thermistor-battery {
		compatible = "murata,ncp15wb473";
		io-channels = <&pmic_auxadc MT6397_AUXADC_BAT_TEMP>;
		pullup-uv = <1200000>;
		pullup-ohm = <24000>;
		pulldown-ohm = <0>;
		#thermal-sensor-cells = <0>;
	};

	thermal-zones {
		/* Read on demand by the fuel gauge, which does its own polling. */
		battery-thermal {
			polling-delay = <0>;
			polling-delay-passive = <0>;
			thermal-sensors = <&batt_therm>;
		};
	};

	lid-switch {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&hall_pins>;

		switch-lid {
			label = "hall-effect-sensor";
			/*
			 * Open-drain hall output: the magnet in the cover pulls
			 * it down, so asserted (lid closed) is low. The vendor
			 * board file spells the same thing as an active-low
			 * level interrupt with an unused GPIO flag.
			 */
			gpios = <&pio 124 GPIO_ACTIVE_LOW>;
			linux,input-type = <EV_SW>;
			linux,code = <SW_LID>;
			debounce-interval = <20>;
		};
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0 0x40000000 0 0x80000000>;
	};

	backlight_enable: regulator-backlight-enable {
		compatible = "regulator-fixed";
		regulator-name = "backlight_enable";
		gpio = <&mt6397pin 14 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/* Not the vendor ram_console at 0x44400000; recovery clears that. */
		ramoops@90000000 {
			compatible = "ramoops";
			reg = <0 0x90000000 0 0x80000>;
			console-size = <0x40000>;
			record-size = <0x8000>;
			ftrace-size = <0x20000>;
		};
	};
};

&cpu0 {
	proc-supply = <&mt6397_vpca15_reg>;
};

&cpu1 {
	proc-supply = <&mt6397_vpca15_reg>;
	enable-method = "mediatek,mt8173-smp";
};

&cpu2 {
	proc-supply = <&mt6311_vcpu_reg>;
	sram-supply = <&mt6397_vsramca7_reg>;
	enable-method = "mediatek,mt8173-smp";
};

&cpu3 {
	proc-supply = <&mt6311_vcpu_reg>;
	sram-supply = <&mt6397_vsramca7_reg>;
	enable-method = "mediatek,mt8173-smp";
};

&dsi0 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	panel@0 {
		compatible = "boe,tv101wum-nm0", "novatek,nt51021";
		reg = <0>;

		vdd-supply = <&mt6397_vgp6_reg>;
		avdd-supply = <&mt6397_vgp6_reg>;
		havdd-supply = <&mt6397_vgp6_reg>;

		reset-gpios = <&pio 105 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&panel_pins>;

		backlight = <&backlight_lcd>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&dsi0_out>;
			};
		};
	};

	port {
		dsi0_out: endpoint {
			remote-endpoint = <&panel_in>;
		};
	};
};

&i2c0 {
	status = "okay";
	clock-frequency = <400000>;

	touchscreen@38 {
		compatible = "evervision,ev-ft5726";
		reg = <0x38>;
		interrupts-extended = <&pio 14 IRQ_TYPE_EDGE_FALLING>;
		reset-gpios = <&mt6397pin 12 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&touch_pins>;
		vcc-supply = <&mt6397_vgp3_reg>;
		iovcc-supply = <&mt6397_vgp4_reg>;

		/* Required: edt-ft5x06 cannot read the sensor counts on an EV_FT part. */
		touchscreen-size-x = <1200>;
		touchscreen-size-y = <1920>;
	};

	rt5514: audio-codec@57 {
		compatible = "realtek,rt5514";
		reg = <0x57>;
		interrupts-extended = <&pio 0 IRQ_TYPE_LEVEL_HIGH>;
		#sound-dai-cells = <0>;
	};
};

&i2c1 {
	status = "okay";
	mediatek,use-push-pull;

	mt6311: pmic@6b {
		compatible = "mediatek,mt6311-regulator";
		reg = <0x6b>;

		regulators {
			/* Pinning Vproc to one voltage hangs the machine under sustained load. */
			mt6311_vcpu_reg: VDVFS {
				regulator-name = "VDVFS";
				regulator-min-microvolt = <600000>;
				regulator-max-microvolt = <1393750>;
				regulator-ramp-delay = <10000>;
				regulator-always-on;
			};

			/* No VBIASN: it is enable-only, and constraints fail registration. */
		};
	};
};

&i2c2 {
	status = "okay";
	clock-frequency = <400000>;

	accelerometer@18 {
		compatible = "bosch,bma253";
		reg = <0x18>;
		mount-matrix = "0", "-1", "0",
			       "-1", "0", "0",
			       "0", "0", "-1";
	};
};

&i2c3 {
	status = "okay";

	bq24297: charger@6b {
		compatible = "ti,bq24297";
		reg = <0x6b>;
		interrupts-extended = <&pio 9 IRQ_TYPE_EDGE_FALLING>;
		pinctrl-names = "default";
		pinctrl-0 = <&charger_pins>;

		/* No fuel gauge on this part, so the battery class would read 0/0. */
		omit-battery-class;
	};
};

&i2c4 {
	status = "okay";
	clock-frequency = <400000>;

	backlight_lcd: backlight@2c {
		compatible = "ti,lp8557";
		reg = <0x2c>;
		enable-supply = <&backlight_enable>;

		dev-ctrl = /bits/ 8 <0x47>;
		init-brt = /bits/ 8 <0x64>;

		/*
		 * Written in the order the vendor driver writes its
		 * "eeprom_data" table, which is not register order.
		 */

		/* 4 V OV, 4 output LED strings enabled */
		rom-14h {
			rom-addr = /bits/ 8 <0x14>;
			rom-val = /bits/ 8 <0x0f>;
		};
		/* boost frequency 1 MHz */
		rom-13h {
			rom-addr = /bits/ 8 <0x13>;
			rom-val = /bits/ 8 <0x01>;
		};
		/* full-scale LED current 23 mA */
		rom-11h {
			rom-addr = /bits/ 8 <0x11>;
			rom-val = /bits/ 8 <0x06>;
		};
		/* 19.5 kHz */
		rom-12h {
			rom-addr = /bits/ 8 <0x12>;
			rom-val = /bits/ 8 <0x2b>;
		};
		/* light smoothing, 100 ms */
		rom-15h {
			rom-addr = /bits/ 8 <0x15>;
			rom-val = /bits/ 8 <0x42>;
		};
		/* max boost voltage 28 V, adaptive */
		rom-16h {
			rom-addr = /bits/ 8 <0x16>;
			rom-val = /bits/ 8 <0xe0>;
		};
	};

	light-sensor@23 {
		compatible = "liteon,ltr559";
		reg = <0x23>;
	};
};

/* Consumes the VPU, which does not run here. See &vpu below. */
&mdp_rdma0 {
	status = "disabled";
};

&mfg_async {
	domain-supply = <&mt6397_vgpu_reg>;
};

/* Also the "hs" clock provider for dsi0, so mtk-dsi needs it. */
&mipi_tx0 {
	status = "okay";
};

&mmc0 {
	status = "okay";
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc0_pins_default>;
	pinctrl-1 = <&mmc0_pins_uhs>;
	bus-width = <8>;
	max-frequency = <200000000>;
	cap-mmc-highspeed;
	mmc-hs200-1_8v;
	mmc-hs400-1_8v;
	hs400-ds-delay = <0x14015>;
	cap-mmc-hw-reset;
	non-removable;
	mediatek,hs200-cmd-int-delay = <30>;
	mediatek,hs400-cmd-int-delay = <14>;
	mediatek,hs400-cmd-resp-sel-rising;
	vmmc-supply = <&mt6397_vemc_3v3_reg>;
	vqmmc-supply = <&mt6397_vio18_reg>;
	/* Reparent MSDC50_0 to MSDCPLL_D2, or HS200 tuning fails -EILSEQ. */
	assigned-clocks = <&topckgen CLK_TOP_MSDC50_0_SEL>;
	assigned-clock-parents = <&topckgen CLK_TOP_MSDCPLL_D2>;
};

&mmc1 {
	status = "okay";
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc1_pins_default>;
	pinctrl-1 = <&mmc1_pins_uhs>;
	bus-width = <4>;
	max-frequency = <200000000>;
	cap-sd-highspeed;
	sd-uhs-sdr50;
	sd-uhs-sdr104;
	/*
	 * The socket shorts this line to ground while the slot is empty and
	 * opens it once a card is seated, so the pull-up in mmc1_pins_default
	 * is what produces the "present" level: active HIGH, where
	 * mt8173-elm's socket is wired the other way up and declares
	 * active low.
	 */
	cd-gpios = <&pio 1 GPIO_ACTIVE_HIGH>;
	vmmc-supply = <&mt6397_vmch_reg>;
	vqmmc-supply = <&mt6397_vmc_reg>;
	mediatek,hs200-cmd-int-delay = <4>;
};

&pio {
	charger_pins: charger-pins {
		pins-int {
			pinmux = <MT8173_PIN_9_EINT9__FUNC_GPIO9>;
			input-enable;
			bias-pull-up;
		};
	};

	hall_pins: hall-pins {
		pins-hall {
			pinmux = <MT8173_PIN_124_KPCOL2__FUNC_GPIO124>;
			input-enable;
			bias-pull-up;
		};
	};

	mmc0_pins_default: mmc0-default-pins {
		pins-cmd-dat {
			pinmux = <MT8173_PIN_57_MSDC0_DAT0__FUNC_MSDC0_DAT0>,
				 <MT8173_PIN_58_MSDC0_DAT1__FUNC_MSDC0_DAT1>,
				 <MT8173_PIN_59_MSDC0_DAT2__FUNC_MSDC0_DAT2>,
				 <MT8173_PIN_60_MSDC0_DAT3__FUNC_MSDC0_DAT3>,
				 <MT8173_PIN_61_MSDC0_DAT4__FUNC_MSDC0_DAT4>,
				 <MT8173_PIN_62_MSDC0_DAT5__FUNC_MSDC0_DAT5>,
				 <MT8173_PIN_63_MSDC0_DAT6__FUNC_MSDC0_DAT6>,
				 <MT8173_PIN_64_MSDC0_DAT7__FUNC_MSDC0_DAT7>,
				 <MT8173_PIN_66_MSDC0_CMD__FUNC_MSDC0_CMD>;
			input-enable;
			bias-pull-up;
		};

		pins-clk {
			pinmux = <MT8173_PIN_65_MSDC0_CLK__FUNC_MSDC0_CLK>;
			bias-pull-down;
		};

		pins-rst {
			pinmux = <MT8173_PIN_68_MSDC0_RST___FUNC_MSDC0_RSTB>;
			bias-pull-up;
		};
	};

	mmc0_pins_uhs: mmc0-uhs-pins {
		pins-cmd-dat {
			pinmux = <MT8173_PIN_57_MSDC0_DAT0__FUNC_MSDC0_DAT0>,
				 <MT8173_PIN_58_MSDC0_DAT1__FUNC_MSDC0_DAT1>,
				 <MT8173_PIN_59_MSDC0_DAT2__FUNC_MSDC0_DAT2>,
				 <MT8173_PIN_60_MSDC0_DAT3__FUNC_MSDC0_DAT3>,
				 <MT8173_PIN_61_MSDC0_DAT4__FUNC_MSDC0_DAT4>,
				 <MT8173_PIN_62_MSDC0_DAT5__FUNC_MSDC0_DAT5>,
				 <MT8173_PIN_63_MSDC0_DAT6__FUNC_MSDC0_DAT6>,
				 <MT8173_PIN_64_MSDC0_DAT7__FUNC_MSDC0_DAT7>,
				 <MT8173_PIN_66_MSDC0_CMD__FUNC_MSDC0_CMD>;
			input-enable;
			drive-strength = <6>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};

		pins-clk {
			pinmux = <MT8173_PIN_65_MSDC0_CLK__FUNC_MSDC0_CLK>;
			drive-strength = <6>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
		};

		pins-ds {
			pinmux = <MT8173_PIN_67_MSDC0_DSL__FUNC_MSDC0_DSL>;
			drive-strength = <8>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
		};

		pins-rst {
			pinmux = <MT8173_PIN_68_MSDC0_RST___FUNC_MSDC0_RSTB>;
			bias-pull-up;
		};
	};

	mmc1_pins_default: mmc1-default-pins {
		pins-cmd-dat {
			pinmux = <MT8173_PIN_73_MSDC1_DAT0__FUNC_MSDC1_DAT0>,
				 <MT8173_PIN_74_MSDC1_DAT1__FUNC_MSDC1_DAT1>,
				 <MT8173_PIN_75_MSDC1_DAT2__FUNC_MSDC1_DAT2>,
				 <MT8173_PIN_76_MSDC1_DAT3__FUNC_MSDC1_DAT3>,
				 <MT8173_PIN_78_MSDC1_CMD__FUNC_MSDC1_CMD>;
			input-enable;
			drive-strength = <4>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};

		pins-clk {
			pinmux = <MT8173_PIN_77_MSDC1_CLK__FUNC_MSDC1_CLK>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
			drive-strength = <4>;
		};

		/* Pulled up so that an empty slot, which grounds it, reads low. */
		pins-insert {
			pinmux = <MT8173_PIN_1_EINT1__FUNC_GPIO1>;
			bias-pull-up;
		};
	};

	mmc1_pins_uhs: mmc1-uhs-pins {
		pins-cmd-dat {
			pinmux = <MT8173_PIN_73_MSDC1_DAT0__FUNC_MSDC1_DAT0>,
				 <MT8173_PIN_74_MSDC1_DAT1__FUNC_MSDC1_DAT1>,
				 <MT8173_PIN_75_MSDC1_DAT2__FUNC_MSDC1_DAT2>,
				 <MT8173_PIN_76_MSDC1_DAT3__FUNC_MSDC1_DAT3>,
				 <MT8173_PIN_78_MSDC1_CMD__FUNC_MSDC1_CMD>;
			input-enable;
			drive-strength = <10>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};

		pins-clk {
			pinmux = <MT8173_PIN_77_MSDC1_CLK__FUNC_MSDC1_CLK>;
			drive-strength = <10>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
		};
	};

	panel_pins: panel-pins {
		pins-reset {
			pinmux = <MT8173_PIN_105_MSDC2_CMD__FUNC_GPIO105>;
			bias-disable;
		};
	};

	touch_pins: touch-pins {
		pins-int {
			pinmux = <MT8173_PIN_14_EINT14__FUNC_GPIO14>;
			input-enable;
			bias-disable;
		};
	};
};

/* Unused as a backlight, but DISP_PWM is on the MT8173 main display path. */
&pwm0 {
	status = "okay";
};

&pwrap {
	pmic: pmic {
		compatible = "mediatek,mt6397";
		/* EINT 5, not the 11 of mt8173-elm and evb, or the line never fires. */
		interrupts-extended = <&pio 5 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-controller;
		#interrupt-cells = <2>;

		mt6397rtc: rtc {
			compatible = "mediatek,mt6397-rtc";

			/*
			 * The first of the RTC's spare bytes, which MediaTek
			 * documents as the fuel gauge's and the vendor kernel
			 * uses for exactly that. Seven bits, because the
			 * eighth is reserved.
			 */
			nvmem-layout {
				compatible = "fixed-layout";
				#address-cells = <1>;
				#size-cells = <1>;

				rtc_soc: state-of-charge@0 {
					reg = <0x0 0x1>;
					bits = <0 7>;
				};
			};
		};

		mt6397clk: clocks {
			compatible = "mediatek,mt6397-clk";
			#clock-cells = <1>;
		};

		mt6397codec: audio-codec {
			compatible = "mediatek,mt6397-codec";
			mediatek,speaker-mode = <0>;
			mediatek,adc-warmup-time-us = <10000>;
			mediatek,dmic-warmup-time-us = <45000>;
		};

		/*
		 * The PMIC's auxiliary ADC. It is the only way to read the
		 * battery voltage on this board: the SoC AUXADC channels are
		 * board thermistors (the vendor's cust_adc.dtsi describes only
		 * temperature0/1 plus an RF channel), and the BQ24297 is a
		 * charger with no ADC, which is why bq24190-battery reports
		 * neither voltage_now nor capacity. Its ISENSE channel is the pack
		 * voltage, which is where the vendor measures it on a board with a
		 * power-path charger, and BAT_TEMP the pack thermistor.
		 */
		pmic_auxadc: adc {
			compatible = "mediatek,mt6397-auxadc";
			#io-channel-cells = <1>;
		};

		/*
		 * The PMIC's fuel gauge, running MediaTek's battery-meter
		 * algorithm on the hardware coulomb counter, exactly as Fire OS
		 * did (CONFIG_SOC_BY_HW_FG). Every number below is the vendor's
		 * own tuning for the Desay pack in this unit, copied from
		 * suez_bat_setting.dtsi battery_dsy_setting and the suez_1v0
		 * defaults in mt_bm_data.c; none is measured here. The tables
		 * are indexed by the battery's ocv-capacity-celsius, so all of
		 * them are at -10, 0, 10, 25 and 50 C (the vendor's t0, t1,
		 * t1_5, t2 and t3), 120 points each.
		 */
		fuel_gauge: battery {
			compatible = "mediatek,mt6397-battery";
			io-channels = <&pmic_auxadc MT6397_AUXADC_ISENSE>;
			io-channel-names = "voltage";
			monitored-battery = <&battery>;
			nvmem-cells = <&rtc_soc>;
			nvmem-cell-names = "state-of-charge";
			power-supplies = <&bq24297>;
			shunt-resistor-micro-ohms = <10000>;	/* r_fg_value */
			mediatek,car-tune-value = <101>;
			mediatek,ocv2cv-transform;
			mediatek,step-of-qmax-microamp-hours = <54000>;
			/* vendor cv_current 6000, in units of 0.1 mA */
			mediatek,cv-current-microamp = <600000>;
			mediatek,poweron-low-capacity-tolerance = <0>;
			/* q_max_pos_* and q_max_pos_*_h_current */
			mediatek,qmax-microamp-hours =
				<5947000 6141000 6210000 6348000 6345000>;
			mediatek,qmax-high-current-microamp-hours =
				<5739000 5568000 5936000 6130000 6133000>;

			/*
			 * The internal resistance the pack has at each point of the
			 * matching ocv-capacity-table, from the same
			 * characterisation. battery.yaml has no property for this:
			 * resistance-temp-table only scales one resistance with
			 * temperature, and this one varies along the discharge curve
			 * as well, by more than a factor of two at -10 C. The
			 * resistance is in microohms, like the voltage beside it and
			 * like factory-internal-resistance-micro-ohms.
			 */
			mediatek,ocv-resistance-table-0 =
				<4275000 254000>, <4252000 254000>, <4237000 263000>,
				<4226000 267000>, <4215000 269000>, <4205000 269000>,
				<4196000 271000>, <4186000 273000>, <4177000 276000>,
				<4167000 282000>, <4158000 296000>, <4149000 320000>,
				<4139000 342000>, <4130000 361000>, <4121000 368000>,
				<4113000 373000>, <4104000 377000>, <4098000 387000>,
				<4092000 396000>, <4088000 400000>, <4083000 401000>,
				<4076000 404000>, <4065000 400000>, <4049000 391000>,
				<4030000 381000>, <4012000 380000>, <3998000 389000>,
				<3987000 394000>, <3978000 397000>, <3971000 398000>,
				<3965000 402000>, <3959000 405000>, <3955000 407000>,
				<3950000 408000>, <3945000 414000>, <3941000 420000>,
