// SPDX-License-Identifier: (GPL-2.0 OR MIT)
/*
 * MediaTek MT8695 SoC
 *
 * Bring-up subset: CPUs, interrupt controllers, timers, the core clock
 * controllers, power domains, pinctrl, the UARTs, the eMMC and SDIO
 * controllers and USB.
 */

#include <dt-bindings/clock/mediatek,mt8695-clk.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/memory/mediatek,mt8695-memory-port.h>
#include <dt-bindings/phy/phy.h>
#include <dt-bindings/power/mediatek,mt8695-power.h>
#include <dt-bindings/thermal/thermal.h>
#include "mt8695-pinfunc.h"

/ {
	compatible = "mediatek,mt8695";
	interrupt-parent = <&sysirq>;
	#address-cells = <2>;
	#size-cells = <2>;

	clk26m: oscillator-26m {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <26000000>;
		clock-output-names = "clk26m";
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x000>;
			enable-method = "psci";
			clocks = <&mcucfg CLK_MCU_BUS_SEL>,
				 <&topckgen CLK_TOP_F_MP0_PLL1>;
			clock-names = "cpu", "intermediate";
			operating-points-v2 = <&cluster0_opp>;
			#cooling-cells = <2>;
		};

		cpu1: cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x001>;
			enable-method = "psci";
			clocks = <&mcucfg CLK_MCU_BUS_SEL>,
				 <&topckgen CLK_TOP_F_MP0_PLL1>;
			clock-names = "cpu", "intermediate";
			operating-points-v2 = <&cluster0_opp>;
			#cooling-cells = <2>;
		};

		cpu2: cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x002>;
			enable-method = "psci";
			clocks = <&mcucfg CLK_MCU_BUS_SEL>,
				 <&topckgen CLK_TOP_F_MP0_PLL1>;
			clock-names = "cpu", "intermediate";
			operating-points-v2 = <&cluster0_opp>;
			#cooling-cells = <2>;
		};

		cpu3: cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x003>;
			enable-method = "psci";
			clocks = <&mcucfg CLK_MCU_BUS_SEL>,
				 <&topckgen CLK_TOP_F_MP0_PLL1>;
			clock-names = "cpu", "intermediate";
			operating-points-v2 = <&cluster0_opp>;
			#cooling-cells = <2>;
		};
	};

	cluster0_opp: opp-table-0 {
		compatible = "operating-points-v2";
		opp-shared;

		opp-754000000 {
			opp-hz = /bits/ 64 <754000000>;
			opp-microvolt = <800000>;
		};

		opp-1014000000 {
			opp-hz = /bits/ 64 <1014000000>;
			opp-microvolt = <800000>;
		};

		opp-1144000000 {
			opp-hz = /bits/ 64 <1144000000>;
			opp-microvolt = <856250>;
		};

		opp-1248000000 {
			opp-hz = /bits/ 64 <1248000000>;
			opp-microvolt = <900000>;
		};

		opp-1352000000 {
			opp-hz = /bits/ 64 <1352000000>;
			opp-microvolt = <950000>;
		};

		opp-1456000000 {
			opp-hz = /bits/ 64 <1456000000>;
			opp-microvolt = <993750>;
		};

		opp-1599000000 {
			opp-hz = /bits/ 64 <1599000000>;
			opp-microvolt = <1056250>;
		};

		opp-1690000000 {
			opp-hz = /bits/ 64 <1690000000>;
			opp-microvolt = <1100000>;
		};
	};

	pmu {
		compatible = "arm,cortex-a53-pmu";
		interrupt-parent = <&gic>;
		interrupts = <GIC_PPI 7 IRQ_TYPE_LEVEL_LOW>;
	};

	psci {
		compatible = "arm,psci-0.2";
		method = "smc";
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/* BL31 (ARM Trusted Firmware) */
		atf-reserved-memory@43000000 {
			reg = <0 0x43000000 0 0x30000>;
			no-map;
		};
	};

	thermal-zones {
		cpu_thermal: cpu-thermal {
			polling-delay-passive = <100>;
			polling-delay = <1000>;
			thermal-sensors = <&thermal>;

			trips {
				cpu_alert: cpu-alert {
					temperature = <90000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_crit: cpu-crit {
					temperature = <110000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_alert>;
					cooling-device =
						<&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
						<&cpu3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <&gic>;
		interrupts = <GIC_PPI 13 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_PPI 14 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_PPI 11 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_PPI 10 IRQ_TYPE_LEVEL_LOW>;
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		gic: interrupt-controller@c000000 {
			compatible = "arm,gic-v3";
			#interrupt-cells = <3>;
			interrupt-parent = <&gic>;
			interrupt-controller;
			reg = <0 0x0c000000 0 0x40000>,		/* GICD */
			      <0 0x0c100000 0 0x200000>;	/* GICR */
			interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH>;
		};

		topckgen: clock-controller@10000000 {
			compatible = "mediatek,mt8695-topckgen", "syscon";
			reg = <0 0x10000000 0 0x1000>;
			#clock-cells = <1>;
		};

		infracfg: clock-controller@10001000 {
			compatible = "mediatek,mt8695-infracfg", "syscon";
			reg = <0 0x10001000 0 0x1000>;
			#clock-cells = <1>;
		};

		pericfg: clock-controller@10003000 {
			compatible = "mediatek,mt8695-pericfg", "syscon";
			reg = <0 0x10003000 0 0x1000>;
			#clock-cells = <1>;
		};

		syscfg_pctl_a: syscon@10005000 {
			compatible = "mediatek,mt8695-pctl-a-syscfg", "syscon";
			reg = <0 0x10005000 0 0x1000>;
		};

		scpsys: syscon@10006000 {
			compatible = "mediatek,mt8695-scpsys", "syscon", "simple-mfd";
			reg = <0 0x10006000 0 0x1000>;

			spm: power-controller {
				compatible = "mediatek,mt8695-power-controller";
				access-controllers = <&infracfg>;
				#address-cells = <1>;
				#size-cells = <0>;
				#power-domain-cells = <1>;

				power-domain@MT8695_POWER_DOMAIN_MM {
					reg = <MT8695_POWER_DOMAIN_MM>;
					clocks = <&topckgen CLK_TOP_MM_SEL>;
					clock-names = "mm";
					#address-cells = <1>;
					#size-cells = <0>;
					#power-domain-cells = <1>;

					power-domain@MT8695_POWER_DOMAIN_VDEC {
						reg = <MT8695_POWER_DOMAIN_VDEC>;
						clocks = <&topckgen CLK_TOP_VDEC_SEL>,
							 <&topckgen CLK_TOP_VDEC_SLOW_SEL>,
							 <&vdecsoc CLK_VDSOC_SOC>;
						clock-names = "vdec", "vdec1", "vdec-0";
						#power-domain-cells = <0>;
					};

					power-domain@MT8695_POWER_DOMAIN_DIS_M {
						reg = <MT8695_POWER_DOMAIN_DIS_M>;
						#address-cells = <1>;
						#size-cells = <0>;
						#power-domain-cells = <1>;

						power-domain@MT8695_POWER_DOMAIN_DIS_S {
							reg = <MT8695_POWER_DOMAIN_DIS_S>;
							#power-domain-cells = <0>;
						};

						power-domain@MT8695_POWER_DOMAIN_DIS_C {
							reg = <MT8695_POWER_DOMAIN_DIS_C>;
							#power-domain-cells = <0>;
						};
					};

					power-domain@MT8695_POWER_DOMAIN_DOLBY {
						reg = <MT8695_POWER_DOMAIN_DOLBY>;
						clocks = <&mmsys CLK_MM_DOLBY1>,
							 <&mmsys CLK_MM_DOLBY2>,
							 <&mmsys CLK_MM_DOLBY3>,
							 <&mmsys CLK_MM_DOLBY_MIX>;
						clock-names = "dolby-0", "dolby-1",
							      "dolby-2", "dolby-3";
						#power-domain-cells = <0>;
					};

					power-domain@MT8695_POWER_DOMAIN_VENC {
						reg = <MT8695_POWER_DOMAIN_VENC>;
						clocks = <&topckgen CLK_TOP_VENC_SEL>,
							 <&topckgen CLK_TOP_DMX_SEL>;
						clock-names = "venc", "demux";
						#power-domain-cells = <0>;
					};
				};

				power-domain@MT8695_POWER_DOMAIN_ETH {
					reg = <MT8695_POWER_DOMAIN_ETH>;
					clocks = <&topckgen CLK_TOP_ETHER_125M_SEL>;
					clock-names = "eth";
					#power-domain-cells = <0>;
				};

				power-domain@MT8695_POWER_DOMAIN_USB {
					reg = <MT8695_POWER_DOMAIN_USB>;
					#power-domain-cells = <0>;
				};

				power-domain@MT8695_POWER_DOMAIN_MFG_ASYNC {
					reg = <MT8695_POWER_DOMAIN_MFG_ASYNC>;
					clocks = <&topckgen CLK_TOP_AXI_MFG_IN_AS_SEL>,
						 <&topckgen CLK_TOP_SLOW_MFG_SEL>;
					clock-names = "axi", "slow";
					#address-cells = <1>;
					#size-cells = <0>;
					#power-domain-cells = <1>;

					power-domain@MT8695_POWER_DOMAIN_MFG_2D {
						reg = <MT8695_POWER_DOMAIN_MFG_2D>;
						#address-cells = <1>;
						#size-cells = <0>;
						#power-domain-cells = <1>;

						power-domain@MT8695_POWER_DOMAIN_MFG {
							reg = <MT8695_POWER_DOMAIN_MFG>;
							clocks = <&topckgen CLK_TOP_MFG_SEL>;
							clock-names = "mfg";
							#power-domain-cells = <0>;
						};
					};
				};
			};
		};

		watchdog: watchdog@10007000 {
			compatible = "mediatek,mt8695-wdt",
				     "mediatek,mt6589-wdt";
			reg = <0 0x10007000 0 0x100>;
		};

		pio: pinctrl@1000b000 {
			compatible = "mediatek,mt8695-pinctrl";
			reg = <0 0x1000b000 0 0x1000>;
			mediatek,pctl-regmap = <&syscfg_pctl_a>;
			pins-are-numbered;
			gpio-controller;
			#gpio-cells = <2>;
			interrupt-controller;
			#interrupt-cells = <2>;
			interrupts = <GIC_SPI 153 IRQ_TYPE_LEVEL_HIGH>;
		};

		iommu: iommu@10205000 {
			compatible = "mediatek,mt8695-m4u";
			reg = <0 0x10205000 0 0x1000>;
			interrupts = <GIC_SPI 147 IRQ_TYPE_LEVEL_LOW>;
			clocks = <&infracfg CLK_INFRA_M4U>;
			clock-names = "bclk";
			mediatek,larbs = <&larb0>, <&larb1>, <&larb4>, <&larb5>, <&larb6>,
					 <&larb7>;
			#iommu-cells = <1>;
		};

		efuse: efuse@10206000 {
			compatible = "mediatek,mt8695-efuse", "mediatek,efuse";
			reg = <0 0x10206000 0 0x1000>;
			#address-cells = <1>;
			#size-cells = <1>;

			thermal_calibration: calib@180 {
				reg = <0x180 0xc>;
			};

			hdmi_calibration: calib@188 {
				reg = <0x188 0x10>;
			};

			svs_calibration: calib@580 {
				reg = <0x580 0x10>;
			};
		};

		apmixedsys: clock-controller@10209000 {
			compatible = "mediatek,mt8695-apmixedsys", "syscon";
			reg = <0 0x10209000 0 0x1000>;
			#clock-cells = <1>;
		};

		rng: rng@1020f000 {
			compatible = "mediatek,mt8695-rng",
				     "mediatek,mt7623-rng";
			reg = <0 0x1020f000 0 0x100>;
			clocks = <&infracfg CLK_INFRA_TRNG>;
			clock-names = "rng";
		};

		mcucfg: clock-controller@10220000 {
			compatible = "mediatek,mt8695-mcucfg", "syscon";
			reg = <0 0x10220000 0 0x1000>;
			#clock-cells = <1>;
		};

		sysirq: interrupt-controller@10220a80 {
			compatible = "mediatek,mt8695-sysirq",
				     "mediatek,mt6577-sysirq";
			interrupt-controller;
			#interrupt-cells = <3>;
			interrupt-parent = <&gic>;
			reg = <0 0x10220a80 0 0x28>;
		};

		auxadc: adc@11001000 {
			compatible = "mediatek,mt8695-auxadc",
				     "mediatek,mt2701-auxadc";
			reg = <0 0x11001000 0 0x1000>;
			clocks = <&pericfg CLK_PERI_AUXADC>;
			clock-names = "main";
			#io-channel-cells = <1>;
		};

		uart0: serial@11002000 {
			compatible = "mediatek,mt8695-uart",
				     "mediatek,mt6577-uart";
			reg = <0 0x11002000 0 0x1000>;
			interrupts = <GIC_SPI 91 IRQ_TYPE_LEVEL_LOW>;
			clocks = <&pericfg CLK_PERI_UART0_SEL>, <&pericfg CLK_PERI_UART0>;
			clock-names = "baud", "bus";
			status = "disabled";
		};

		uart1: serial@11003000 {
			compatible = "mediatek,mt8695-uart",
				     "mediatek,mt6577-uart";
			reg = <0 0x11003000 0 0x1000>;
			interrupts = <GIC_SPI 92 IRQ_TYPE_LEVEL_LOW>;
			clocks = <&pericfg CLK_PERI_UART1_SEL>, <&pericfg CLK_PERI_UART1>;
			clock-names = "baud", "bus";
			status = "disabled";
		};

		i2c1: i2c@11008000 {
			compatible = "mediatek,mt8695-i2c",
				     "mediatek,mt2712-i2c";
			reg = <0 0x11008000 0 0x90>,
			      <0 0x11000100 0 0x80>;
			interrupts = <GIC_SPI 85 IRQ_TYPE_LEVEL_LOW>;
			clock-div = <4>;
			clocks = <&pericfg CLK_PERI_I2C1>,
				 <&pericfg CLK_PERI_AP_DMA>;
			clock-names = "main", "dma";
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		thermal: thermal@1100b000 {
			compatible = "mediatek,mt8695-thermal";
			reg = <0 0x1100b000 0 0x1000>;
			interrupts = <GIC_SPI 110 IRQ_TYPE_LEVEL_LOW>;
			clocks = <&pericfg CLK_PERI_THERM>,
				 <&pericfg CLK_PERI_AUXADC>;
			clock-names = "therm", "auxadc";
			mediatek,auxadc = <&auxadc>;
			mediatek,apmixedsys = <&apmixedsys>;
			nvmem-cells = <&thermal_calibration>;
			nvmem-cell-names = "calibration-data";
			#thermal-sensor-cells = <0>;
		};

		svs: svs@1100bc00 {
			compatible = "mediatek,mt8695-svs";
			reg = <0 0x1100bc00 0 0x400>;
			interrupts = <GIC_SPI 125 IRQ_TYPE_LEVEL_LOW>;
			clocks = <&pericfg CLK_PERI_THERM>,
				 <&pericfg CLK_PERI_PTP_THERM>;
			clock-names = "main", "count";
			nvmem-cells = <&svs_calibration>,
				      <&thermal_calibration>;
			nvmem-cell-names = "svs-calibration-data",
					   "t-calibration-data";
			status = "disabled";
		};

		audsys: clock-controller@11220000 {
			compatible = "mediatek,mt8695-audsys", "syscon";
			reg = <0 0x11220000 0 0x2000>;
			clocks = <&topckgen CLK_TOP_AUD_INTBUS_SEL>;
			#clock-cells = <1>;

			afe: audio-controller {
				compatible = "mediatek,mt8695-audio";
				interrupts = <GIC_SPI 242 IRQ_TYPE_LEVEL_LOW>,
					     <GIC_SPI 142 IRQ_TYPE_LEVEL_LOW>;
				interrupt-names = "afe", "asys";
				clocks = <&audsys CLK_AUD_AFE>,
					 <&audsys CLK_AUD_AFE_CONN>,
					 <&audsys CLK_AUD_A1SYS>,
					 <&audsys CLK_AUD_A2SYS>,
					 <&audsys CLK_AUD_APLL>,
					 <&audsys CLK_AUD_HDMI>,
					 <&topckgen CLK_TOP_APLL_SEL>,
					 <&topckgen CLK_TOP_APLL2_SEL>;
				clock-names = "afe", "afe_conn", "a1sys", "a2sys",
					      "apll", "hdmi", "apll1", "apll2";
				assigned-clocks = <&apmixedsys CLK_APMIXED_APLL1>,
						  <&apmixedsys CLK_APMIXED_APLL2>,
						  <&topckgen CLK_TOP_APLL_SEL>,
						  <&topckgen CLK_TOP_APLL2_SEL>,
						  <&topckgen CLK_TOP_A1SYS_HP_SEL>,
						  <&topckgen CLK_TOP_A2SYS_HP_SEL>,
						  <&topckgen CLK_TOP_AUD_INTBUS_SEL>;
				assigned-clock-parents = <0>, <0>,
							 <&topckgen CLK_TOP_APLL1>,
							 <&topckgen CLK_TOP_APLL2>,
							 <&topckgen CLK_TOP_APLL1_D4>,
							 <&topckgen CLK_TOP_APLL2_D4>,
							 <&topckgen CLK_TOP_SYSPLL1_D4>;
				assigned-clock-rates = <196608000>, <180633600>;
				status = "disabled";
			};
		};

		mmc0: mmc@11230000 {
			compatible = "mediatek,mt8695-mmc",
				     "mediatek,mt2712-mmc";
			reg = <0 0x11230000 0 0x1000>;
			interrupts = <GIC_SPI 79 IRQ_TYPE_LEVEL_LOW>;
			clocks = <&pericfg CLK_PERI_MSDC30_0>,
				 <&pericfg CLK_PERI_MSDC50_0_HCLK_EN>,
				 <&pericfg CLK_PERI_MSDC50_0_EN>;
			clock-names = "source", "hclk", "source_cg";
			assigned-clocks = <&topckgen CLK_TOP_MSDC50_0_SEL>;
			assigned-clock-parents = <&topckgen CLK_TOP_MSDCPLL>;
			status = "disabled";
		};

		mmc2: mmc@11250000 {
			compatible = "mediatek,mt8695-mmc",
				     "mediatek,mt2712-mmc";
			reg = <0 0x11250000 0 0x1000>;
			interrupts = <GIC_SPI 81 IRQ_TYPE_LEVEL_LOW>;
			clocks = <&pericfg CLK_PERI_MSDC30_2>,
				 <&pericfg CLK_PERI_MSDC50_2_HCLK_EN>,
				 <&pericfg CLK_PERI_MSDC30_2_EN>;
			clock-names = "source", "hclk", "source_cg";
			assigned-clocks = <&topckgen CLK_TOP_MSDC30_2_SEL>;
			assigned-clock-parents = <&topckgen CLK_TOP_MSDCPLL_D2>;
			status = "disabled";
		};

		ssusb: usb@11271000 {
			compatible = "mediatek,mt8695-mtu3", "mediatek,mtu3";
			reg = <0 0x11271000 0 0x3000>,
			      <0 0x11280700 0 0x0100>;
			reg-names = "mac", "ippc";
			interrupts = <GIC_SPI 122 IRQ_TYPE_LEVEL_LOW>;
			phys = <&u2port0 PHY_TYPE_USB2>,
			       <&u2port1 PHY_TYPE_USB2>;
			power-domains = <&spm MT8695_POWER_DOMAIN_USB>;
			clocks = <&topckgen CLK_TOP_USB30_SEL>,
				 <&clk26m>,
				 <&pericfg CLK_PERI_USB>,
				 <&pericfg CLK_PERI_USB>;
			clock-names = "sys_ck", "ref_ck", "mcu_ck", "dma_ck";
			#address-cells = <2>;
			#size-cells = <2>;
			ranges;
			status = "disabled";

			usb_host: usb@11270000 {
				compatible = "mediatek,mt8695-xhci",
					     "mediatek,mtk-xhci";
				reg = <0 0x11270000 0 0x1000>;
				reg-names = "mac";
				interrupts = <GIC_SPI 123 IRQ_TYPE_LEVEL_LOW>;
				power-domains = <&spm MT8695_POWER_DOMAIN_USB>;
				clocks = <&topckgen CLK_TOP_USB30_SEL>, <&clk26m>;
				clock-names = "sys_ck", "ref_ck";
				status = "disabled";
			};
		};

		tphy: t-phy@11500000 {
			compatible = "mediatek,mt8695-tphy",
				     "mediatek,generic-tphy-v2";
			#address-cells = <1>;
			#size-cells = <1>;
			ranges = <0 0 0x11500000 0x2000>;
			status = "disabled";

			u2port1: usb-phy@0 {
				reg = <0x0 0x400>;
				clocks = <&clk26m>;
				clock-names = "ref";
				#phy-cells = <1>;
			};

			u2port0: usb-phy@1000 {
				reg = <0x1000 0x400>;
				clocks = <&clk26m>;
				clock-names = "ref";
				#phy-cells = <1>;
			};
		};

		hdmi_phy: hdmi-phy@11702000 {
			compatible = "mediatek,mt8695-hdmi-phy";
			reg = <0 0x11702000 0 0x100>;
			clocks = <&apmixedsys CLK_APMIXED_HDMITX20_CKSEL>;
			clock-names = "pll_ref";
			clock-output-names = "hdmitx20_pll";
			nvmem-cells = <&hdmi_calibration>;
			nvmem-cell-names = "intr-cal";
			mediatek,ibias = <0x10>;
			mediatek,ibias_up = <0x1a>;
			#clock-cells = <0>;
			#phy-cells = <0>;
			status = "disabled";
		};

		mfgcfg: clock-controller@13ffe000 {
			compatible = "mediatek,mt8695-mfgcfg", "syscon";
			reg = <0 0x13ffe000 0 0x1000>;
			power-domains = <&spm MT8695_POWER_DOMAIN_MFG_2D>;
			#clock-cells = <1>;
		};

		mmsys: syscon@14000000 {
			compatible = "mediatek,mt8695-mmsys", "syscon";
			reg = <0 0x14000000 0 0x1000>;
			#clock-cells = <1>;
			#reset-cells = <1>;
		};

		vdout: display-controller@14001000 {
			compatible = "mediatek,mt8695-vdout";
			reg = <0 0x14001000 0 0x1000>,
			      <0 0x14002000 0 0x1000>;
			reg-names = "vdout", "hdr";
			interrupts = <GIC_SPI 185 IRQ_TYPE_LEVEL_LOW>,
				     <GIC_SPI 186 IRQ_TYPE_LEVEL_LOW>;
			power-domains = <&spm MT8695_POWER_DOMAIN_MM>;
			clocks = <&topckgen CLK_TOP_HD_SEL>,
				 <&mmsys CLK_MM_VDOUT>,
				 <&mmsys CLK_MM_FMT_TG>,
				 <&mmsys CLK_MM_OSD_PREMIX>,
				 <&mmsys CLK_MM_RGB2HDMI>,
				 <&mmsys CLK_MM_OSD_SDR2HDR>,
				 <&apmixedsys CLK_APMIXED_TVDPLL>;
			clock-names = "hd", "vdout", "fmt", "premix", "rgb2hdmi",
				      "sdr2hdr", "tvdpll";
			resets = <&mmsys 9>;
			reset-names = "rgb2hdmi";
			mediatek,mmsys = <&mmsys>;
			status = "disabled";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					vdout_in_fhd: endpoint {
						remote-endpoint = <&osd_fhd_out>;
					};
				};

				port@1 {
					reg = <1>;

					vdout_in_uhd: endpoint {
						remote-endpoint = <&osd_uhd_out>;
					};
				};

				port@2 {
					reg = <2>;

					vdout_out: endpoint {
						remote-endpoint = <&hdmi_in>;
					};
				};

				port@3 {
					reg = <3>;

					vdout_in_vdo_main: endpoint {
						remote-endpoint = <&vdo_main_out>;
					};
				};

				port@4 {
					reg = <4>;

					vdout_in_vdo_sub: endpoint {
						remote-endpoint = <&vdo_sub_out>;
					};
				};
			};
		};

		osd_fhd: osd@14003000 {
			compatible = "mediatek,mt8695-osd-fhd";
			reg = <0 0x14003000 0 0x300>;
			interrupts = <GIC_SPI 190 IRQ_TYPE_LEVEL_LOW>;
			power-domains = <&spm MT8695_POWER_DOMAIN_MM>;
			clocks = <&topckgen CLK_TOP_OSD_SEL>,
				 <&mmsys CLK_MM_OSD_FHD>;
			clock-names = "osd", "plane";
			assigned-clocks = <&apmixedsys CLK_APMIXED_OSDPLL>;
			assigned-clock-rates = <648000000>;
			iommus = <&iommu M4U_PORT_FHD_OSD>;
			status = "disabled";

			port {
				osd_fhd_out: endpoint {
					remote-endpoint = <&vdout_in_fhd>;
				};
			};
		};

		osd_uhd: osd@14004300 {
			compatible = "mediatek,mt8695-osd-uhd";
			reg = <0 0x14004300 0 0x300>;
			power-domains = <&spm MT8695_POWER_DOMAIN_MM>;
			clocks = <&topckgen CLK_TOP_OSD_SEL>,
				 <&mmsys CLK_MM_OSD_UHD>;
			clock-names = "osd", "plane";
			iommus = <&iommu M4U_PORT_UHD_OSD>;
			status = "disabled";

			port {
				osd_uhd_out: endpoint {
					remote-endpoint = <&vdout_in_uhd>;
				};
			};
		};

		hdmi: hdmi@14006000 {
			compatible = "mediatek,mt8695-hdmi-tx";
			reg = <0 0x14006000 0 0x1000>;
			interrupts = <GIC_SPI 195 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&mmsys CLK_MM_HDMITX>,
				 <&topckgen CLK_TOP_HDCP_SEL>,
				 <&topckgen CLK_TOP_HDCP_24M_SEL>;
			clock-names = "bus", "hdcp", "hdcp24m";
			phys = <&hdmi_phy>;
			phy-names = "hdmi";
			power-domains = <&spm MT8695_POWER_DOMAIN_MM>;
			#sound-dai-cells = <1>;
			status = "disabled";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				hdmi_port_in: port@0 {
					reg = <0>;

					hdmi_in: endpoint {
						remote-endpoint = <&vdout_out>;
					};
				};

				hdmi_port_out: port@1 {
					reg = <1>;
				};
			};
		};

		larb0: larb@1400c000 {
			compatible = "mediatek,mt8695-smi-larb";
			reg = <0 0x1400c000 0 0x1000>;
			clocks = <&mmsys CLK_MM_SMI_LARB0>, <&mmsys CLK_MM_SMI_LARB0>;
			clock-names = "apb", "smi";
			power-domains = <&spm MT8695_POWER_DOMAIN_MM>;
			mediatek,larb-id = <0>;
			mediatek,smi = <&smi_common>;
		};

		smi_common: smi@1400d000 {
			compatible = "mediatek,mt8695-smi-common";
			reg = <0 0x1400d000 0 0x1000>;
			clocks = <&mmsys CLK_MM_SMI_COMMON>, <&mmsys CLK_MM_SMI_COMMON>;
			clock-names = "apb", "smi";
			power-domains = <&spm MT8695_POWER_DOMAIN_MM>;
		};

		larb4: larb@1400e000 {
			compatible = "mediatek,mt8695-smi-larb";
			reg = <0 0x1400e000 0 0x1000>;
			clocks = <&mmsys CLK_MM_SMI_LARB4>, <&mmsys CLK_MM_SMI_LARB4>;
			clock-names = "apb", "smi";
			power-domains = <&spm MT8695_POWER_DOMAIN_MM>;
			mediatek,larb-id = <4>;
			mediatek,smi = <&smi_common>;
		};

		dispsys: clock-controller@15000000 {
			compatible = "mediatek,mt8695-dispsys", "syscon";
			reg = <0 0x15000000 0 0x1000>;
			power-domains = <&spm MT8695_POWER_DOMAIN_DIS_M>;
			#clock-cells = <1>;
		};

		vdo_main: video-plane@15001000 {
			compatible = "mediatek,mt8695-vdo-main";
			reg = <0 0x15001000 0 0x1000>;
			power-domains = <&spm MT8695_POWER_DOMAIN_DIS_M>;
			clocks = <&dispsys CLK_DISP_VDO3>, <&dispsys CLK_DISP_FMT3>,
				 <&topckgen CLK_TOP_VDO3_SEL>;
			clock-names = "vdo", "fmt", "sel";
			iommus = <&iommu M4U_PORT_VDO3_UFOD_Y_LENGTH>,
				 <&iommu M4U_PORT_VDO3_UFOD_C_LENGTH>,
				 <&iommu M4U_PORT_VDO3_UFOD_Y1>,
				 <&iommu M4U_PORT_VDO3_UFOD_Y2>,
				 <&iommu M4U_PORT_VDO3_UFOD_Y3>,
				 <&iommu M4U_PORT_VDO3_UFOD_Y4>,
				 <&iommu M4U_PORT_VDO3_UFOD_C1>,
				 <&iommu M4U_PORT_VDO3_UFOD_C2>,
				 <&iommu M4U_PORT_VDO3_UFOD_C3>,
				 <&iommu M4U_PORT_VDO3_UFOD_C4>;
			mediatek,dispsys = <&dispsys>;

			port {
				vdo_main_out: endpoint {
					remote-endpoint = <&vdout_in_vdo_main>;
				};
			};
		};

		larb5: larb@15004000 {
			compatible = "mediatek,mt8695-smi-larb";
			reg = <0 0x15004000 0 0x1000>;
			clocks = <&mmsys CLK_MM_SMI_LARB5>, <&dispsys CLK_DISP_SMI_LARB5>;
			clock-names = "apb", "smi";
			power-domains = <&spm MT8695_POWER_DOMAIN_DIS_M>;
			mediatek,larb-id = <5>;
			mediatek,smi = <&smi_common>;
		};

		larb6: larb@15005000 {
			compatible = "mediatek,mt8695-smi-larb";
			reg = <0 0x15005000 0 0x1000>;
			clocks = <&mmsys CLK_MM_SMI_LARB6>, <&dispsys CLK_DISP_SMI_LARB6>;
			clock-names = "apb", "smi";
			power-domains = <&spm MT8695_POWER_DOMAIN_DIS_M>;
			mediatek,larb-id = <6>;
			mediatek,smi = <&smi_common>;
		};

		vdo_sub: video-plane@15008000 {
			compatible = "mediatek,mt8695-vdo-sub";
			reg = <0 0x15008000 0 0x1000>;
			power-domains = <&spm MT8695_POWER_DOMAIN_DIS_S>;
			clocks = <&dispsys CLK_DISP_VDO4>, <&dispsys CLK_DISP_FMT4>,
				 <&topckgen CLK_TOP_VDO4_SEL>;
			clock-names = "vdo", "fmt", "sel";
			iommus = <&iommu M4U_PORT_VDO4_UFOD_Y_LENGTH>,
				 <&iommu M4U_PORT_VDO4_UFOD_C_LENGTH>,
				 <&iommu M4U_PORT_VDO4_UFOD_Y1>,
				 <&iommu M4U_PORT_VDO4_UFOD_C1>,
				 <&iommu M4U_PORT_VDO4_UFOD_Y2>,
				 <&iommu M4U_PORT_VDO4_UFOD_C2>;
			mediatek,dispsys = <&dispsys>;

			port {
				vdo_sub_out: endpoint {
					remote-endpoint = <&vdout_in_vdo_sub>;
				};
			};
		};

		larb7: larb@1600e000 {
			compatible = "mediatek,mt8695-smi-larb";
			reg = <0 0x1600e000 0 0x1000>;
			clocks = <&mmsys CLK_MM_SMI_LARB7>, <&vdecsoc CLK_VDSOC_LARB7>,
				 <&vdecsoc CLK_VDSOC_SOC>;
			clock-names = "apb", "smi", "gals";
			power-domains = <&spm MT8695_POWER_DOMAIN_VDEC>;
			mediatek,larb-id = <7>;
			mediatek,smi = <&smi_common>;
		};

		vdecsoc: clock-controller@1600f000 {
			compatible = "mediatek,mt8695-vdecsoc", "syscon";
			reg = <0 0x1600f000 0 0x1000>;
			#clock-cells = <1>;
		};

		larb1: larb@1602e000 {
			compatible = "mediatek,mt8695-smi-larb";
			reg = <0 0x1602e000 0 0x1000>;
			clocks = <&mmsys CLK_MM_SMI_LARB1>, <&vdeccore CLK_VDCORE_LARB1>,
				 <&vdeccore CLK_VDCORE_VDEC>;
			clock-names = "apb", "smi", "gals";
			power-domains = <&spm MT8695_POWER_DOMAIN_VDEC>;
			mediatek,larb-id = <1>;
			mediatek,smi = <&smi_common>;
		};

		/* DO NOT UPSTREAM: probe test only */
		vdec-probe-test {
			compatible = "mediatek,mt8695-vdec-probe-test";
			power-domains = <&spm MT8695_POWER_DOMAIN_VDEC>;
			clocks = <&topckgen CLK_TOP_VDEC_SEL>,
				 <&topckgen CLK_TOP_VDEC_SLOW_SEL>,
				 <&topckgen CLK_TOP_VDEC_LAE_SEL>,
				 <&vdecsoc CLK_VDSOC_SOC>,
				 <&vdecsoc CLK_VDSOC_LARB7>,
				 <&vdeccore CLK_VDCORE_VDEC>,
				 <&vdeccore CLK_VDCORE_LARB1>;
			assigned-clocks = <&topckgen CLK_TOP_VDEC_SEL>,
					  <&topckgen CLK_TOP_VDEC_LAE_SEL>,
					  <&topckgen CLK_TOP_VDEC_SLOW_SEL>;
			assigned-clock-parents = <&topckgen CLK_TOP_VDECPLL>,
						 <&topckgen CLK_TOP_VDECPLL>,
						 <&topckgen CLK_TOP_OSDPLL_D2>;
			iommus = <&iommu M4U_PORT_HW_VDEC_MC_EXT>,
				 <&iommu M4U_PORT_HW_VDEC_UFO_EXT>,
				 <&iommu M4U_PORT_HW_VDEC_PP_EXT>,
				 <&iommu M4U_PORT_HW_VDEC_PRED_RD_EXT>,
				 <&iommu M4U_PORT_HW_VDEC_PRED_WR_EXT>,
				 <&iommu M4U_PORT_HW_VDEC_PPWRAP_EXT>,
				 <&iommu M4U_PORT_HW_VDEC_TILE>,
				 <&iommu M4U_PORT_HW_VDEC_VLD_EXT>,
				 <&iommu M4U_PORT_HW_VDEC_VLD2_EXT>,
				 <&iommu M4U_PORT_HW_VDEC_AVC_MV_EXT>,
				 <&iommu M4U_PORT_HW_VDEC_UFO_ENC_EXT>;
		};

		vdeccore: clock-controller@1602f000 {
			compatible = "mediatek,mt8695-vdeccore", "syscon";
			reg = <0 0x1602f000 0 0x1000>;
			#clock-cells = <1>;
		};
	};
};
