/dts-v1/;

#include "omap4-samsung-espresso-common.dtsi"
#include <dt-bindings/power/summit,smb347-charger.h>
/ {
	model = "Samsung Galaxy Tab 2 (10 inch)";
	compatible = "samsung,espresso10", "ti,omap4430", "ti,omap4";

	/* 7000 mAh pack; charge settings as in the vendor kernel */
	battery: battery {
		compatible = "simple-battery";
		device-chemistry = "lithium-ion-polymer";
		charge-full-design-microamp-hours = <7000000>;
		voltage-min-design-microvolt = <3400000>;
		voltage-max-design-microvolt = <4200000>;
		constant-charge-voltage-max-microvolt = <4200000>;
		constant-charge-current-max-microamp = <2200000>;
		precharge-current-microamp = <250000>;
		charge-term-current-microamp = <250000>;
	};

	i2c-gpio5 {
		smb347: charger@6 {
			compatible = "summit,smb347";
			reg = <0x6>; // 0x0C >> 1
			interrupt-parent = <&gpio2>;
			interrupts = <0 IRQ_TYPE_EDGE_BOTH>;

			summit,enable-usb-charging;
			summit,enable-charge-control = <SMB3XX_CHG_ENABLE_SW>;
			summit,chip-temperature-threshold-celsius = <120>;
			summit,usb-current-limit-microamp = <1800000>;
			monitored-battery = <&battery>;
		};
	};

	sound {
		/*
		 * WIP, polarity unverified: the vendor kernel treats both lines
		 * as active low (inserted, key pressed), but with the pad muxed
		 * as GPIO, DET_3_5 reads low while the ADC shows an unloaded
		 * headset mic line (about 2.78 V with the bias on), i.e. with
		 * nothing plugged in. Thresholds (mV) from the vendor's
		 * espresso10 jack zones.
		 */
		pinctrl-names = "default";
		pinctrl-0 = <&jack_pins>;
		headset-detect-gpios = <&gpio1 0 GPIO_ACTIVE_LOW>; /* DET_3_5 */
		headset-key-gpios = <&gpio1 4 GPIO_ACTIVE_LOW>; /* EAR_SEND_END */
		io-channels = <&stmpe_adc 0>; /* channel 4 */
		io-channel-names = "headset-detect";
		samsung,headset-4pole-threshold-microvolt = <1020 2800>;
		samsung,headset-button-threshold-microvolt = <0 145 335>;
	};

	backlight: backlight {
		compatible = "pwm-backlight";
		pinctrl-names = "default";
		pinctrl-0 = <&backlight_pins>;
		pwms = <&pwm10 0 1600 0>;
		power-supply = <&reg_lcd>;
		enable-gpios = <&gpio3 31 GPIO_ACTIVE_HIGH>;
		brightness-levels = <0 4 8 16 32 64 128 255>;
		default-brightness-level = <7>;
	};

	panel {
		compatible = "samsung,ltn101al03", "panel-lvds";
		power-supply = <&reg_lcd>;
		width-mm = <223>;
		height-mm = <125>;
		data-mapping = "vesa-24";
		backlight = <&backlight>;

		panel-timing {
			clock-frequency = <69818000>;

			hback-porch = <64>;
			hactive = <1280>;
			hfront-porch = <16>;
			hsync-len = <48>;

			vback-porch = <11>;
			vactive = <800>;
			vfront-porch = <16>;
			vsync-len = <3>;

			hsync-active = <0>;
			vsync-active = <0>;
			de-active = <1>;
			pixelclk-active = <1>;
		};

		port {
			panel_in: endpoint {
				remote-endpoint = <&bridge_out>;
			};
		};
	};
};

&i2c3 {
	touchscreen@20 {
		compatible = "syna,rmi4-i2c";
		reg = <0x20>;
		#address-cells = <1>;
		#size-cells = <0>;

		interrupt-parent = <&gpio2>;
		interrupts = <14 IRQ_TYPE_EDGE_FALLING>;

		pinctrl-names = "default";
		pinctrl-0 = <&touch_pins>;

		//avdd-supply = <&reg_touch_ldo_en>;
		vdd-supply = <&ldo6>;

		syna,reset-delay-ms = <200>;
		syna,startup-delay-ms = <200>;

		rmi4-f01@1 {
			reg = <0x01>;
			syna,nosleep-mode = <1>;
		};

		rmi4-f11@11 {
			reg = <0x11>;
			touchscreen-size-x = <1280>;
			touchscreen-size-y = <800>;
			syna,sensor-type = <1>;
		};
	};
};

/* The bootloader's framebuffer is sized for this panel, not the 7" one */
&continuous_splash {
	reg = <0xbef00000 (1280 * 800 * 4)>;
};

&fuel_gauge {
	power-supplies = <&smb347>;
	monitored-battery = <&battery>;
};

&i2c4 {
	accelerometer@18 {
		/* orientation 6 (BMA250 position 5) in the vendor kernel */
		mount-matrix = "-1", "0", "0",
			       "0", "1", "0",
			       "0", "0", "-1";
	};

	light-sensor@23 {
		compatible = "rohm,bh1721";
		reg = <0x23>;
		pinctrl-names = "default";
		pinctrl-0 = <&als_pins>;
		reset-gpios = <&gpio2 1 GPIO_ACTIVE_LOW>; /* GPIO_33 */
	};

	magnetometer@2e {
		/* orientation 7 (YAS530 position 6) in the vendor kernel */
		mount-matrix = "0", "1", "0",
			       "1", "0", "0",
			       "0", "0", "-1";
	};
};

&omap4_pmx_core {
	als_pins: pinmux-als-pins {
		pinctrl-single,pins = <
			OMAP4_IOPAD(0x052, PIN_OUTPUT | MUX_MODE3)
			/* gpmc_ad9.gpio_33 - ALS_INT_18 (BH1721 DVI) */
		>;
	};
};

&omap4_pmx_wkup {
	jack_pins: pinmux-jack-pins {
		pinctrl-single,pins = <
			OMAP4_IOPAD(0x040, PIN_INPUT | MUX_MODE3)
			/* sim_io.gpio_wk0 - DET_3.5 */
			OMAP4_IOPAD(0x048, PIN_INPUT | MUX_MODE3)
			/* sim_pwrctrl.gpio_wk4 - EAR_SEND_END */
		>;
	};
};
